rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to validate sync payload (supports both GZip Base64 String & Uncompressed Map)
    function isValidSyncPayload() {
      return request.resource.data.keys().hasAll(['data', 'lastSyncedAt'])
        && (
          (request.resource.data.compressed == true && request.resource.data.data is string)
          || (request.resource.data.data is map)
          || (request.resource.data.data is string)
        );
    }

    // User profile and synced data rules
    match /users/{userId} {
      allow read, delete: if isAuthenticated() && request.auth.uid == userId;

      // Create and update rules with top-level key count guard (< 50 fields) and payload validation.
      // Byte size safety (< 900 KB) is enforced client-side in sync_provider.dart + Firestore 1 MB hard limit.
      allow create, update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.keys().size() < 50
        && isValidSyncPayload();
    }
  }
}
